    zn "%SYS"
    do ##class(Security.Users).UnExpireUserPasswords("*")

    zn "IRISAPP"
    do $system.OBJ.LoadDir("/home/irisowner/dev/src","ck",,1)
    // Lookup Table, Workflow role and users, data folders and SetAutoStart: see LabTriage.Installer.
    set sc = ##class(LabTriage.Installer).Setup("/home/irisowner/dev/")
    if 'sc { write !,"Setup failed: ",$system.Status.GetErrorText(sc),! do $system.Process.Terminate(,1) }
    halt
